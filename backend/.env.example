# Copy to .env and fill in your own key.
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Google Earth Engine service-account credentials (gee-key.json) are NOT an
# env var for local dev — the file is auto-discovered at the project root or
# backend/ (see app/services/gee_utils.py's get_key_path()). Never commit
# this file; it's already covered by .gitignore. Set GEE_KEY_PATH to
# override the location explicitly if needed.
# GEE_KEY_PATH=/absolute/path/to/gee-key.json

# --- Deployment (Render/Railway/etc.) ---
# Hosts where you can't upload gee-key.json as a file: paste the *entire*
# contents of your service-account JSON key as a single env var instead.
# Takes priority over GEE_KEY_PATH if both are set. Never commit the real
# value — set it in the host's secret/environment variable dashboard only.
# GEE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}

# Comma-separated list of additional allowed CORS origins for a deployed
# frontend (e.g. Vercel/Netlify) — local dev origins are always allowed
# regardless of this setting. Example:
# FRONTEND_ORIGINS=https://sahan.vercel.app
